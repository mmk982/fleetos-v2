# Copy to `.env.production` on the VPS (git-ignored). Replace every CHANGE_ME.
# Never commit real values. Never put owner DB passwords in the app service.

# --- Public / TLS ---
# Prod hostname (Caddy HTTPS + ACME). Local compose test: http://localhost
DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
APP_BASE_URL=https://app.example.com

# --- App runtime (fleetos_app — RLS, NOBYPASSRLS) ---
# Compose wires DATABASE_URL for the `app` service from these pieces:
POSTGRES_DB=fleetos
POSTGRES_APP_USER=fleetos_app
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_ROLE_PASSWORD
# Assembled inside compose as:
#   postgres://fleetos_app:${POSTGRES_APP_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --- Owner / migrate (migrate service ONLY — never mount into `app`) ---
POSTGRES_OWNER_USER=fleetos
POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
# Assembled for migrate as DATABASE_MIGRATE_URL + temporary DATABASE_URL=owner

# --- Session / cron (≥32 chars each) ---
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_OF_RANDOM
CRON_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_OF_RANDOM

# --- Client IP for login rate limiting ---
# Number of trusted proxies in front of the app (Caddy = 1). Keep 1 in production;
# 0 ignores X-Forwarded-For (developer laptop only). See docs/DEPLOY.md.
TRUSTED_PROXY_HOPS=1

# --- Optional email ---
# RESEND_API_KEY=re_CHANGE_ME
# RESEND_FROM_EMAIL=FleetOS <noreply@example.com>

# --- Optional GlitchTip (compose profile `observability`) ---
# GLITCHTIP_DSN=https://CHANGE_ME@glitchtip.example.com/1
# GLITCHTIP_SECRET_KEY=CHANGE_ME_GLITCHTIP_DJANGO_SECRET

# --- Backups (scripts/backup) ---
# AGE_RECIPIENT=age1CHANGE_ME_PUBLIC_KEY_ONLY
# BACKUP_ROOT=/var/backups/fleetos
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_RETENTION_MONTHLY=6
# RCLONE_REMOTE=b2:CHANGE_ME_BUCKET/fleetos
# (rclone.conf lives outside the repo — see docs/DEPLOY.md)
