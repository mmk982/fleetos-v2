# Copy to `.env.local` (or `.env`) for local development.
# Never commit real production credentials.
#
# Note: this file is force-tracked despite `.env*` in `.gitignore`
# (see `!.env.example` exception). Real `.env.local` stays ignored.

# Local Postgres via `docker compose up -d` (see docker-compose.yml).
# Host port 5433 avoids a native Windows Postgres on 5432.
DATABASE_URL=postgres://fleetos:fleetos@localhost:5433/fleetos

# HMAC secret for signing the httpOnly session cookie (Phase 3).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-chars-of-random-data

# Shared secret for server-to-server cron routes (e.g. daily email digest).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-at-least-32-chars-of-random-data

# Absolute origin used in digest links (no trailing slash). Defaults to
# http://localhost:3000 when unset.
APP_BASE_URL=http://localhost:3000

# Resend outbound email (Admin daily digest — PROJECT_PLAN.md §12b).
# When RESEND_API_KEY is unset, sendEmail logs and no-ops (safe for local dev).
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=FleetOS <noreply@your-domain.com>

# Optional — GlitchTip (Sentry-compatible DSN) after:
#   docker compose --profile observability up -d
# Open http://localhost:8000, create org/project, paste the DSN here.
# GLITCHTIP_DSN=http://<key>@localhost:8000/<project_id>

# --- GitHub Actions staging deploy (Task 2.2) — repo secrets, not local ---
# Configure these under Settings → Secrets and variables → Actions, and
# attach them to the `staging` Environment (required reviewers = deploy gate):
#   STAGING_HOST       — SSH host for the staging VPS (Phase 7 Hetzner)
#   STAGING_SSH_USER   — SSH username (e.g. deploy)
#   STAGING_SSH_KEY    — private key for STAGING_SSH_USER
#   STAGING_APP_PATH   — remote path to the app compose project (optional)
